<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Winche.Rules</PackageId>
    <Description>A declarative, JSON-serializable authorization rules engine. Define document access rules in C# (or load them as data), evaluate them in memory, and analyze queries against them. Backend-agnostic via small adapter ports.</Description>
    <PackageTags>authorization;rules;access-control;security-rules;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Rules.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
